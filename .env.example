# Backend
# Pooler de transacción (puerto 6543 en Supabase) para la app
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
# Conexión directa o session pooler (5432) para migraciones; si falta se usa DATABASE_URL
DIRECT_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
# Mínimo 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# true en producción (HTTPS). Poner false solo en desarrollo local por HTTP
COOKIE_SECURE=true
# Orígenes permitidos, separados por comas. Nunca '*'
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
