# Backend
# Neon: host con sufijo "-pooler" (PgBouncer en modo transacción) para la app.
# asyncpg usa ssl=require, no sslmode=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-NOMBRE-pooler.REGION.aws.neon.tech/neondb?ssl=require
# Neon: el mismo host sin "-pooler" (conexión directa) para migraciones; si falta se usa DATABASE_URL
DIRECT_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-NOMBRE.REGION.aws.neon.tech/neondb?ssl=require
# Mínimo 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# true en producción (HTTPS). Poner false solo en desarrollo local por HTTP
COOKIE_SECURE=true
# Orígenes permitidos, separados por comas. Nunca '*'
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
